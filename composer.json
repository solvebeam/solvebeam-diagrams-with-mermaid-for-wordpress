{
	"name": "solvebeam/solvebeam-diagrams-with-mermaid-for-wordpress",
	"description": "A plugin for rendering Mermaid diagrams and visualizations from Mermaid code.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"SolveBeam\\WordPressMermaid\\": "psr-4/"
		}
	},
	"authors": [
		{
			"name": "SolveBeam",
			"email": "info@solvebeam.com",
			"homepage": "https://www.solvebeam.com/",
			"role": "Developer"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "https://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require": {
		"php": "^8.3",
		"automattic/jetpack-autoloader": "^6.0",
		"composer/installers": "^2.3"
	},
	"require-dev": {
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.6",
		"roots/wordpress-no-content": "^7.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:solvebeam",
				"vendor:wp-pay",
				"woocommerce/action-scheduler"
			]
		},
		"wp-slug": "solvebeam-diagrams-with-mermaid"
	},
	"scripts": {
		"build": [
			"@build:prepare",
			"@build:archive:wordpress-org",
			"@build:archive:standalone"
		],
		"build:prepare": [
			"npm run build",
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/"
		],
		"build:archive:wordpress-org": [
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore --exclude=languages/ ./build/stage-1/ ./build/solvebeam-diagrams-with-mermaid/",
			"vendor/bin/wp dist-archive ./build/solvebeam-diagrams-with-mermaid/ --plugin-dirname=solvebeam-diagrams-with-mermaid --force"
		],
		"build:archive:standalone": [
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/solvebeam-diagrams-with-mermaid-standalone/",
			"vendor/bin/wp i18n make-pot ./build/solvebeam-diagrams-with-mermaid-standalone/ --slug=solvebeam-diagrams-with-mermaid --exclude=blocks/*.js",
			"vendor/bin/wp i18n make-mo ./build/solvebeam-diagrams-with-mermaid-standalone/languages/",
			"vendor/bin/wp dist-archive ./build/solvebeam-diagrams-with-mermaid-standalone/ --plugin-dirname=solvebeam-diagrams-with-mermaid --filename-format={name}-standalone.{version} --force"
		],
		"build:wordpress-org": [
			"@build:prepare",
			"@build:archive:wordpress-org"
		],
		"build:standalone": [
			"@build:prepare",
			"@build:archive:standalone"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=solvebeam-diagrams-with-mermaid",
		"make-pot": [
			"@build:standalone",
			"rsync --recursive --delete --verbose ./build/solvebeam-diagrams-with-mermaid-standalone/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/solvebeam-diagrams-with-mermaid.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1"
	}
}
