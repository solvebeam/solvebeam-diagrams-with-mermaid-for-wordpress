{
	"name": "@solvebeam/solvebeam-mermaid-for-wordpress",
	"version": "1.0.0",
	"description": "A plugin for rendering Mermaid diagrams and visualizations from Mermaid code.",
	"author": "SolveBeam",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"solvebeam"
	],
	"homepage": "https://github.com/solvebeam/solvebeam-mermaid-for-wordpress#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/solvebeam/solvebeam-mermaid-for-wordpress.git"
	},
	"bugs": {
		"url": "https://github.com/solvebeam/solvebeam-mermaid-for-wordpress/issues"
	},
	"dependencies": {
		"mermaid": "^12.0.0"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/env": "^11.15.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/scripts": "^35.0.0",
		"npm-run-all": "^4.1.5"
	},
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"lint:js:src": "wp-scripts lint-js ./blocks-src",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"build": "npm-run-all build-wp-scripts",
		"build-wp-scripts": "wp-scripts build --webpack-src-dir=blocks-src --output-path=blocks",
		"start": "wp-scripts start --webpack-src-dir=blocks-src --output-path=blocks"
	}
}
